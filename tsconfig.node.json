{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "noEmit": true,    // Add this: Prevents output generation for configs
    "strict": true     // Add this: Matches your main config for consistency
  },
  "include": ["vite.config.ts"]
}